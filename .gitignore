# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Distribution / packaging
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual environments
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/

# Environment variables and secrets
.env
.env.*
*.secret

# Jupyter Notebook checkpoints
.ipynb_checkpoints/
*/.ipynb_checkpoints/*

# IDE and editor artifacts
.idea/
.vscode/
*.swp
*.swo

# Operating System files
Thumbs.db
Desktop.ini
.DS_Store

# Data files (track .gitkeep to preserve directory structure)
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep

# Generated experiment outputs (track .gitkeep to preserve directory structure)
results/figures/*
!results/figures/.gitkeep
results/tables/*
!results/tables/.gitkeep
